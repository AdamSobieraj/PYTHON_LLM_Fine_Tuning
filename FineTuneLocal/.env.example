# =========================
# USTAWIENIA
# =========================

MODEL_ID=HuggingFaceTB/SmolLM2-360M-Instruct
DATA_FILE=test.jsonl
ADAPTER_DIR=lora_adapter
MERGED_DIR=fine_tuned_local
MERGE_MODEL=True
MAX_LEN=512

# Learning rate — pozostaw puste, aby wybrac domyslna wartosc wg PEFT_METHOD
#   full fine-tuning: 2e-5 .. 5e-5   (np. 3e-5)
#   LoRA/DoRA/QLoRA:  1e-4 .. 3e-4   (np. 2e-4)
LEARNING_RATE=3e-5
WARMUP_RATIO=0.05

MODEL_PATH=fine_tuned_local
BASE_MODEL=HuggingFaceTB/SmolLM2-360M-Instruct

SYSTEM_PROMPT='Classify the article into exactly one category: business, entertainment, politics, sport, tech. Reply with only the category word.'
CATEGORIES=business,entertainment,politics,sport,tech

MERGE_FOR_INFERENCE=0

# =========================
# WYBÓR METODY
# =========================

#DoRA + 4-bit
#PEFT_METHOD=dora
#USE_4BIT=1

#DoRA bez 4-bit
#PEFT_METHOD=dora
#USE_4BIT=0

Zwykły LoRA
PEFT_METHOD=lora
USE_4BIT=0

##Zwykły LoRA
#PEFT_METHOD=full
#USE_4BIT=0

# parametry LoRA/DoRA
LORA_R=16
LORA_ALPHA=32
LORA_DROPOUT=0.05
LORA_TARGET_MODULES=q_proj,v_proj

# opcje pamięciowe
DOUBLE_QUANT=1
GRADIENT_CHECKPOINTING=1
